# Model for interviewer chat and the written scorecard review (OpenAI-compatible API).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# External sandbox API. Use a Judge0 CE-compatible deployment with network execution disabled.
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_LANGUAGE_ID=71

# Render workflow trigger + workflow-to-web callback.
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=interviewsim
APP_PUBLIC_URL=http://127.0.0.1:8000
INTERNAL_CALLBACK_SECRET=replace-with-a-long-random-secret

# Optional verification secret for the eventual Nonilion webhook adapter.
NONILION_WEBHOOK_SECRET=

# Local development defaults to SQLite. Render Blueprint injects Postgres.
DATABASE_URL=sqlite:///./data/interviewsim.sqlite3
SESSION_MINUTES=45
